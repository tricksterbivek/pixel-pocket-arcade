# SuiteCloud CLI auth — copy to .env and fill in real values (never commit .env)
# Run: suitecloud account:savetoken --authid <NS_AUTH_ID> --account <NS_ACCOUNT_ID> ...
# Then reference the authid in suitecloud.config.js

# The account ID / auth ID configured with suitecloud account:setup
NS_AUTH_ID=your-auth-id-here

# Optional: used only in local dev proxy (e.g. vite proxy target)
# VITE_SUITELET_URL=https://your-netsuite-account.app.netsuite.com/app/site/hosting/scriptlet.nl?script=xxx&deploy=1
